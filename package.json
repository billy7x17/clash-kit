{
  "name": "billy-clash-kit",
  "version": "1.2.0",
  "type": "module",
  "description": "A command-line interface for managing Clash configurations, subscriptions, and proxies.",
  "homepage": "https://github.com/billy7x17/clash-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billy7x17/clash-kit.git"
  },
  "bugs": {
    "url": "https://github.com/billy7x17/clash-kit/issues"
  },
  "bin": {
    "ck": "./dist/bin/index.js",
    "clash": "./dist/bin/index.js"
  },
  "files": [
    "dist",
    ".gitignore",
    "default.yaml",
    "country.mmdb",
    "LICENSE.md",
    "package.json",
    "README.md",
    "kernels"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node bin/index.js start",
    "download:kernels": "node scripts/download-kernels.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "sub": "node bin/index.js sub",
    "use": "node bin/index.js use",
    "list": "node bin/index.js list",
    "init": "node bin/index.js init",
    "status": "node bin/index.js status",
    "stop": "node bin/index.js stop",
    "tun": "node bin/index.js tun",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "clash",
    "proxy",
    "cli",
    "subscription",
    "manager"
  ],
  "author": {
    "name": "billy7x17",
    "url": "https://github.com/billy7x17"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@inquirer/prompts": "^8.1.0",
    "@mihomo-party/sysproxy": "^2.0.8",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.2",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.2",
    "inquirer": "^13.1.0",
    "ora": "^9.0.0",
    "update-notifier": "^7.3.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
